{
  "name": "homelab-vault-gen",
  "version": "2.4.0",
  "private": true,
  "description": "Offline credential generator with development-only browser regression tooling",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node tests/repository.cjs && node tests/core.cjs && node tests/test-cli.cjs",
    "cli": "node cli/vault.cjs",
    "test:cli": "node tests/test-cli.cjs",
    "test:browser": "playwright test --config tests/playwright.config.js",
    "test:browser:headed": "playwright test --config tests/playwright.config.js --headed",
    "test:all": "npm test && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "jsqr": "1.4.0"
  }
}
