# ===========================================================================
# Homelab Vault — Caddyfile
# ===========================================================================
# Caddy auto-provisions and renews TLS certificates. This is the cleanest
# way to satisfy the Web Crypto "secure context" requirement for non-
# localhost access (Web Crypto refuses to run on plain HTTP).
#
# Pick ONE of the site blocks below by removing the leading '#' from its
# lines, edit the hostname if needed, then:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
# ===========================================================================

# Reusable security headers (mirrors the NGINX hardening profile).
(security_headers) {
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "clipboard-read=(), clipboard-write=(self)"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';"
        Cache-Control "no-store, no-cache, must-revalidate, private"
        -Server
    }
}

# ---------------------------------------------------------------------------
# OPTION 1 — Zero-config localhost (same-machine only).
# Caddy generates a cert via its internal CA and automatically trusts it on
# this machine. Visit https://localhost after starting Caddy. Useful for
# trying the tool with a real secure context before going further.
# ---------------------------------------------------------------------------
# localhost {
#     root * /var/www/html
#     file_server
#     encode gzip
#     import security_headers
# }

# ---------------------------------------------------------------------------
# OPTION 2 — Local network access via LAN IP or local hostname.
# Replace HOST with your server's LAN IP (e.g. 192.168.1.50) or a local
# hostname (e.g. vault.lan). Clients on OTHER devices will see a cert warning
# the first time, because Caddy's internal CA is not trusted by default. To
# silence the warning, copy Caddy's root cert to each client and install it
# as a trusted root:
#   /var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt
# ---------------------------------------------------------------------------
# https://HOST {
#     tls internal
#     root * /var/www/html
#     file_server
#     encode gzip
#     import security_headers
# }

# ---------------------------------------------------------------------------
# OPTION 3 — Public domain with automatic Let's Encrypt certificate.
# Requires:
#   - A DNS A/AAAA record for vault.example.com pointing at this server.
#   - Ports 80 AND 443 reachable from the internet (HTTP-01 challenge).
# Replace vault.example.com with your domain. No browser warnings — clients
# trust Let's Encrypt out of the box.
# ---------------------------------------------------------------------------
# vault.example.com {
#     root * /var/www/html
#     file_server
#     encode gzip
#     import security_headers
# }
