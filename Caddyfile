# ===========================================================================
# Homelab Vault — Caddyfile
# ===========================================================================
# Caddy auto-provisions and renews TLS certificates. This is the cleanest
# way to satisfy the Web Crypto "secure context" requirement for non-
# localhost access (Web Crypto refuses to run on plain HTTP).
# ===========================================================================

# Reusable security headers (mirrors the NGINX hardening profile).
(security_headers) {
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "clipboard-read=(), clipboard-write=(self)"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';"
        Cache-Control "no-store, no-cache, must-revalidate, private"
        -Server
    }
}

# ---------------------------------------------------------------------------
# OPTION 2 (Default) — Local network access via hostname.
# Clients on OTHER devices will see a cert warning the first time, because 
# Caddy's internal CA is not trusted by default. Install Caddy's root cert
# on each client to silence the warning:
#   /var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt
# ---------------------------------------------------------------------------
https://HOST IP {
    tls internal
    root * /var/www/html
    file_server
    encode gzip
    import security_headers
}

# ---------------------------------------------------------------------------
# OPTION 1 — Zero-config localhost (same-machine only).
# ---------------------------------------------------------------------------
# localhost {
#     root * /var/www/html
#     file_server
#     encode gzip
#     import security_headers
# }

# ---------------------------------------------------------------------------
# OPTION 3 — Public domain with automatic Let's Encrypt certificate.
# ---------------------------------------------------------------------------
# vault.example.com {
#     root * /var/www/html
#     file_server
#     encode gzip
#     import security_headers
# }
